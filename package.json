{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "studio": "cd studio && sanity dev",
    "studio:build": "cd studio && sanity build",
    "studio:deploy": "cd studio && sanity deploy",
    "schema:extract": "cd studio && sanity schema extract --path ./schema.json --enforce-required-fields --force",
    "typegen": "npm run schema:extract && cd studio && sanity typegen generate",
    "seed": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-sanity.mts"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-sanity": "^13.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@sanity/client": "^7.16.0",
    "@sanity/vision": "^6.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "sanity": "^6.8.0",
    "styled-components": "^6.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
